{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "olimp-algorithms-lab",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/app",
      "/teacher*",
      "/student*",
      "/"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "olimp-classroom",
      "database_id": "1d0213a9-9750-4f85-8445-95990f85030f",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  }
}